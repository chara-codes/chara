{
  "name": "@chara-codes/server",
  "module": "src/index.ts",
  "types": "./src/index.ts",
  "version": "0.1.30",
  "type": "module",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/chokidar": "^2.1.7",
    "@types/node": "^22.18.13",
    "drizzle-kit": "^0.31.6"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "bbuild": "bun build ./src/server.ts --minify --outfile ./dist/server --target=bun --compile",
    "start": "./dist/server",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ttest": "bun test"
  },
  "dependencies": {
    "@chara-codes/logger": "workspace:*",
    "@chara-codes/settings": "workspace:*",
    "@chara-codes/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@trpc/client": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "ai": "^5.0.82",
    "chokidar": "^4.0.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.7.1",
    "eventsource": "^4.0.0",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
