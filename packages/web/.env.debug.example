# Debug Mode Configuration for Chara Web Frontend
# Copy this file to .env or .env.local to enable debug features

# Enable debug mode for message parts rendering
# This will show debug panels and source data for all message parts
VITE_DEBUG_PARTS=true

# Other debug-related environment variables (examples)
# VITE_DEBUG_API=true
# VITE_DEBUG_WEBSOCKETS=true
# VITE_LOG_LEVEL=debug

# Development server configuration
# VITE_API_URL=http://localhost:3030
# VITE_WS_URL=ws://localhost:3030

# Note: In Vite, environment variables must be prefixed with VITE_
# to be accessible in the browser. Variables without this prefix
# will only be available on the server side.
