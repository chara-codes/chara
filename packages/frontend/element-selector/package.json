{
  "name": "@chara-codes/element-selector",
  "version": "0.1.29",
  "description": "Element selector hook utilities for Chara frontend applications",
  "author": "Chara Team",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "bbuild": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "llint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "ttest": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.18.13",
    "eslint": "^9.38.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chara-codes/chara.git",
    "directory": "packages/frontend/core"
  },
  "keywords": [
    "chara",
    "frontend",
    "core",
    "utilities",
    "react",
    "zustand",
    "trpc"
  ]
}
