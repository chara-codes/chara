{
  "name": "@chara-codes/element-selector",
  "version": "0.1.28",
  "description": "Element selector hook utilities for Chara frontend applications",
  "author": "Chara Team",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "bbuild": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "ttest": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "tsup": "^8.5.0",
    "eslint": "^9.30.0",
    "@types/node": "^22.15.33"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chara-codes/chara.git",
    "directory": "packages/frontend/core"
  },
  "keywords": [
    "chara",
    "frontend",
    "core",
    "utilities",
    "react",
    "zustand",
    "trpc"
  ]
}
