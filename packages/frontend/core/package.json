{
  "name": "@chara-codes/core",
  "version": "0.1.29",
  "description": "Core utilities and shared components for Chara frontend applications",
  "author": "Chara Team",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "bbuild": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "bunx biome lint",
    "llint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "ttest": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.118",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "ai": "^5.0.116",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.548.0",
    "styled-components": "^6.1.19",
    "superjson": "^2.2.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chara-codes/chara.git",
    "directory": "packages/frontend/core"
  },
  "keywords": [
    "chara",
    "frontend",
    "core",
    "utilities",
    "react",
    "zustand",
    "trpc"
  ]
}
