{
  "name": "@chara-codes/core",
  "version": "0.1.29",
  "description": "Core utilities and shared components for Chara frontend applications",
  "author": "Chara Team",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "bbuild": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "ttest": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.57",
    "@trpc/react-query": "^11.6.0",
    "date-fns": "^4.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chara-codes/chara.git",
    "directory": "packages/frontend/core"
  },
  "keywords": [
    "chara",
    "frontend",
    "core",
    "utilities",
    "react",
    "zustand",
    "trpc"
  ]
}
