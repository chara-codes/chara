    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "wxt": "^0.20.11"
